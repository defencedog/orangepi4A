		ir@7040000 {
			compatible = "allwinner,sun55i-a523-ir", "allwinner,sun6i-a31-ir";
			reg = <0x7040000 0x400>;
			interrupts = <0x00 0xa7 0x04>;
			clocks = <0x4b 0x17 0x4b 0x16>;
			clock-names = "apb", "ir";
			resets = <0x4b 0x0c>;
			status = "okay";
			pinctrl-names = "default";
			pinctrl-0 = <0x4d>;
		};

		power-controller@7060000 {
			compatible = "allwinner,sun55i-a523-pck-600";
			reg = <0x7060000 0x8000>;
			clocks = <0x4b 0x13>;
			resets = <0x4b 0x0f>;
			#power-domain-cells = <0x01>;
			phandle = <0x18>;
		};

		i2c@7081400 {
			compatible = "allwinner,sun55i-a523-i2c", "allwinner,sun8i-v536-i2c", "allwinner,sun6i-a31-i2c";
			reg = <0x7081400 0x400>;
			interrupts = <0x00 0xa4 0x04>;
			clocks = <0x4b 0x10>;
			resets = <0x4b 0x08>;
			pinctrl-names = "default";
			pinctrl-0 = <0x4e>;
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			pmic@35 {
				compatible = "x-powers,axp717";
				reg = <0x35>;
				interrupt-controller;
				#interrupt-cells = <0x01>;
				interrupts-extended = <0x4f 0x00 0x08>;
				vin1-supply = <0x50>;
				vin2-supply = <0x50>;
				vin3-supply = <0x50>;
				vin4-supply = <0x50>;
				aldoin-supply = <0x50>;
				bldoin-supply = <0x50>;
				cldoin-supply = <0x50>;

				adc {
					compatible = "x-powers,axp717-adc";
					#io-channel-cells = <0x01>;
					phandle = <0x57>;
				};

				battery-power {
					compatible = "x-powers,axp717-battery-power-supply";
					status = "disabled";
				};

				regulators {

					dcdc1 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x11b340>;
						regulator-name = "vdd-cpul";
						phandle = <0x05>;
					};

					dcdc2 {
						regulator-always-on;
						regulator-min-microvolt = <0xe09c0>;
						regulator-max-microvolt = <0xe09c0>;
						regulator-name = "vdd-gpu-sys";
						phandle = <0x19>;
					};

					dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <0x11b340>;
						regulator-max-microvolt = <0x11b340>;
						regulator-name = "vcc-dram";
					};

					dcdc4 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vdd-io";
					};

					aldo1 {
						regulator-name = "avdd-csi";
					};

					aldo2 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pe";
						phandle = <0x2f>;
					};

					aldo3 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-pl-usb";
					};

					aldo4 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pll-dxco-avcc";
						phandle = <0x54>;
					};

					bldo1 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pg-wifi";
						phandle = <0x30>;
					};

					bldo2 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-pm-lpddr";
						phandle = <0x4c>;
					};

					bldo3 {
						regulator-name = "afvcc-csi";
					};

					bldo4 {
						regulator-name = "dvdd-csi";
					};

					cldo1 {
						regulator-always-on;
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-name = "vcc-cvp-pc-lvds-mcsi-pk-efuse-pcie-edp-1v8";
						phandle = <0x2e>;
					};

					cldo2 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc3v3-csi";
					};

					cldo3 {
						regulator-always-on;
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-io-mmc-nand-pd-pi-usb";
						phandle = <0x2d>;
					};

					cldo4 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-3v3-phy1-lcd";
						phandle = <0x47>;
					};

					cpusldo {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xdbba0>;
						regulator-name = "vdd-cpus-usb-0v9";
					};
				};

				usb-power {
					compatible = "x-powers,axp717-usb-power-supply";
					input-current-limit-microamp = <0x2dc6c0>;
				};
			};

			pmic@36 {
				compatible = "x-powers,axp323";
				reg = <0x36>;
				#interrupt-cells = <0x01>;
				interrupt-controller;
				status = "okay";
				vin1-supply = <0x50>;
				vin2-supply = <0x50>;
				vin3-supply = <0x50>;

				regulators {

					aldo1 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-wifi";
						phandle = <0x35>;
					};

					dldo1 {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-name = "vcc-wifi2";
						phandle = <0x3b>;
					};

					dcdc1 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0x118c30>;
						regulator-name = "vdd-cpub";
						phandle = <0x07>;
					};

					dcdc3 {
						regulator-always-on;
						regulator-min-microvolt = <0xdbba0>;
						regulator-max-microvolt = <0xdbba0>;
						regulator-name = "vdd-dnr";
					};
				};
			};
		};

		rtc@7090000 {
			compatible = "allwinner,sun55i-a523-rtc", "allwinner,sun50i-r329-rtc";
			reg = <0x7090000 0x400>;
			interrupts = <0x00 0x9d 0x04>;
			clocks = <0x4b 0x19 0x2b 0x4b 0x00 0x51>;
			clock-names = "bus", "hosc", "ahb", "ext-osc32k";
			#clock-cells = <0x01>;
			assigned-clocks = <0x2c 0x00>;
			assigned-clock-rates = <0x8000>;
			phandle = <0x2c>;
		};

		clock-controller@7102000 {
			compatible = "allwinner,sun55i-a523-mcu-ccu";
			reg = <0x7102000 0x200>;
			clocks = <0x2b 0x2c 0x00 0x2c 0x02 0x17 0x23 0x17 0x07 0x17 0xa9 0x17 0x2c 0x4b 0x00 0x4b 0x01>;
			clock-names = "hosc", "losc", "iosc", "pll-audio0-4x", "pll-periph0-300m", "dsp", "mbus", "r-ahb", "r-apb0";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x52>;
		};

		codec@7110000 {
			compatible = "allwinner,sun55i-a523-codec";
			reg = <0x7110000 0x350>;
			interrupts = <0x00 0xbe 0x04>;
			clocks = <0x52 0x15 0x52 0x13 0x52 0x14>;
			clock-names = "bus", "dac", "adc";
			resets = <0x52 0x06>;
			dmas = <0x53 0x07 0x53 0x07>;
			dma-names = "tx", "rx";
			status = "okay";
			avcc-supply = <0x54>;
			vdd-supply = <0x2d>;
			cpvin-supply = <0x2e>;
			allwinner,pa-gpios = <0x38 0x07 0x06 0x00>;
		};

		i2s@7114000 {
			compatible = "allwinner,sun55i-a523-i2s", "allwinner,sun50i-r329-i2s";
			reg = <0x7114000 0x1000>;
			interrupts = <0x00 0xc2 0x04>;
			clocks = <0x52 0x0c 0x52 0x07>;
			clock-names = "apb", "mod";
			resets = <0x52 0x02>;
			dmas = <0x53 0x05 0x53 0x05>;
			dma-names = "rx", "tx";
			#sound-dai-cells = <0x00>;
			status = "okay";
			phandle = <0x59>;
		};

		dma-controller@7121000 {
			compatible = "allwinner,sun55i-a523-mcu-dma", "allwinner,sun50i-a100-dma";
			reg = <0x7121000 0x1000>;
			interrupts = <0x00 0xc5 0x04>;
			clocks = <0x52 0x21 0x52 0x25>;
			clock-names = "bus", "mbus";
			dma-channels = <0x08>;
			dma-requests = <0x0f>;
			resets = <0x52 0x0d>;
			#dma-cells = <0x01>;
			phandle = <0x53>;
		};

		npu@7122000 {
			compatible = "vivante,gc";
			reg = <0x7122000 0x1000>;
			interrupts = <0x00 0xc7 0x04>;
			clocks = <0x52 0x19 0x17 0xb3 0x52 0x18>;
			clock-names = "bus", "core", "reg";
			resets = <0x52 0x09>;
			power-domains = <0x55 0x01>;
		};

		clock-controller@8817000 {
			compatible = "allwinner,sun55i-a523-cpu-ccu";
			reg = <0x8817000 0x4000>;
			clocks = <0x2b 0x2c 0x00 0x2c 0x02 0x17 0x05 0x17 0x02>;
			clock-names = "hosc", "losc", "iosc", "pll-periph0-600m", "pll-periph0-2x";
			#clock-cells = <0x01>;
			phandle = <0x04>;
		};

		g2d@5440000 {
			compatible = "allwinner,sunxi-g2d";
			reg = <0x5440000 0x3ffff>;
			interrupts = <0x00 0x8f 0x04>;
			clocks = <0x17 0x32 0x17 0x31>;
			clock-names = "bus", "g2d";
			resets = <0x17 0x04>;
			iommus = <0x03 0x04>;
			assigned-clocks = <0x17 0x31>;
			assigned-clock-rates = <0x11e1a300>;
			status = "okay";
		};

		sunxi-drm {
		};

		de {
		};
	};

	aliases {
		serial0 = "/soc/serial@2500000";
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";

		framebuffer@bbea2000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0xbbea2000 0x00 0x3fc000>;
			memory-region = <0x56>;
			width = <0x550>;
			height = <0x300>;
			stride = <0x1540>;
			format = "x8r8g8b8";
			power-domains = <0x18 0x05 0x18 0x03>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x80000000>;
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		sec-sram1@42350000 {
			reg = <0x00 0x42350000 0x00 0x230000>;
			no-map;
		};

		sec-sram2@43000000 {
			reg = <0x00 0x43000000 0x00 0x94000>;
			no-map;
		};

		bl31@48000000 {
			reg = <0x00 0x48000000 0x00 0x1000000>;
			no-map;
		};

		optee@4941d000 {
			reg = <0x00 0x4941d000 0x00 0xbe3000>;
			no-map;
		};

		framebuffer@bbea2000 {
			reg = <0x00 0xbbea2000 0x00 0x3fc000>;
			no-map;
			phandle = <0x56>;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x4000000>;
			alloc-ranges = <0x00 0x43000000 0x00 0x5000000>;
			linux,cma-default;
			phandle = <0x1f>;
		};
	};

	ext-osc32k-clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "ext_osc32k";
		phandle = <0x51>;
	};

	leds {
		compatible = "gpio-leds";

		led {
			function = "status";
			color = <0x02>;
			gpios = <0x38 0x03 0x14 0x00>;
			linux,default-trigger = "heartbeat";
		};
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <0x57 0x03 0x57 0x04 0x57 0x07>;
	};

	pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <0x36 0x01 0x01 0x01>;
		clocks = <0x2c 0x01>;
		clock-names = "ext_clock";
		phandle = <0x3a>;
	};

	regulator-otg-vbus {
		compatible = "regulator-fixed";
		regulator-name = "otg-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x50>;
		gpio = <0x36 0x00 0x04 0x00>;
		enable-active-high;
		regulator-always-on;
		phandle = <0x3e>;
	};

	regulator-pcie-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-pcie-3v3";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		vin-supply = <0x50>;
		gpio = <0x36 0x00 0x08 0x00>;
		enable-active-high;
		phandle = <0x4a>;
	};

	regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		vin-supply = <0x50>;
		gpio = <0x36 0x00 0x0c 0x00>;
		enable-active-high;
		phandle = <0x3f>;
	};

	regulator-vcc5v {
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <0x4c4b40>;
		regulator-max-microvolt = <0x4c4b40>;
		regulator-always-on;
		phandle = <0x50>;
	};

	opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x06>;

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt = <0xdbba0 0xdbba0 0x118c30>;
		};

		opp-792000000 {
			opp-hz = <0x00 0x2f34f600>;
			opp-microvolt = <0xdbba0 0xdbba0 0x118c30>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0xea600 0xea600 0x118c30>;
		};

		opp-1224000000 {
			opp-hz = <0x00 0x48f4c200>;
			opp-microvolt = <0x100590 0x100590 0x118c30>;
		};

		opp-1416000000 {
			opp-hz = <0x00 0x54667200>;
			opp-microvolt = <0x118c30 0x118c30 0x118c30>;
		};
	};

	opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;
		phandle = <0x08>;

		opp-480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			opp-microvolt = <0xdbba0>;
		};

		opp-1008000000 {
			opp-hz = <0x00 0x3c14dc00>;
			opp-microvolt = <0xdbba0>;
		};

		opp-1200000000 {
			opp-hz = <0x00 0x47868c00>;
			opp-microvolt = <0xe09c0>;
		};

		opp-1344000000 {
			opp-hz = <0x00 0x501bd000>;
			opp-microvolt = <0xea600>;
		};

		opp-1488000000 {
			opp-hz = <0x00 0x58b11400>;
			opp-microvolt = <0xf4240>;
		};

		opp-1584000000 {
			opp-hz = <0x00 0x5e69ec00>;
			opp-microvolt = <0x100590>;
		};

		opp-1680000000 {
			opp-hz = <0x00 0x6422c400>;
			opp-microvolt = <0x10c8e0>;
		};

		opp-1800000000 {
			opp-hz = <0x00 0x6b49d200>;
			opp-microvolt = <0x118c30>;
		};
	};

	opp-table-gpu {
		compatible = "operating-points-v2";
		phandle = <0x1a>;

		opp-150000000 {
			opp-hz = <0x00 0x8f0d180>;
			opp-microvolt = <0xe09c0>;
		};

		opp-200000000 {
			opp-hz = <0x00 0xbebc200>;
			opp-microvolt = <0xe09c0>;
		};

		opp-300000000 {
			opp-hz = <0x00 0x11e1a300>;
			opp-microvolt = <0xe09c0>;
		};

		opp-400000000 {
			opp-hz = <0x00 0x17d78400>;
			opp-microvolt = <0xe09c0>;
		};

		opp-600000000 {
			opp-hz = <0x00 0x23c34600>;
			opp-microvolt = <0xe09c0>;
		};

		opp-696000000 {
			opp-hz = <0x00 0x297c1e00>;
			opp-microvolt = <0xe09c0>;
		};
	};

	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {

			endpoint {
				remote-endpoint = <0x58>;
				phandle = <0x2a>;
			};
		};
	};

	hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sndhdmi";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <0x80>;

		simple-audio-card,cpu {
			sound-dai = <0x59>;
			dai-tdm-slot-num = <0x02>;
			dai-tdm-slot-width = <0x20>;
		};

		simple-audio-card,codec {
			sound-dai = <0x5a>;
		};
	};
};
