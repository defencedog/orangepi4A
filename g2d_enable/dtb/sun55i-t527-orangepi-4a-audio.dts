/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "OrangePi 4A";
	compatible = "xunlong,orangepi-4a", "allwinner,sun55i-t527";

	display-engine {
		compatible = "allwinner,sun50i-h6-display-engine";
		allwinner,pipelines = <0x02>;
		status = "okay";
		iommus = <0x03 0x05>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x00>;
			enable-method = "psci";
			clocks = <0x04 0x03>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x39a>;
			dynamic-power-coefficient = <0x11e>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x05>;
			operating-points-v2 = <0x06>;
			phandle = <0x09>;
		};

		cpu@100 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x100>;
			enable-method = "psci";
			clocks = <0x04 0x03>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x39a>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x05>;
			operating-points-v2 = <0x06>;
			phandle = <0x0a>;
		};

		cpu@200 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x200>;
			enable-method = "psci";
			clocks = <0x04 0x03>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x39a>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x05>;
			operating-points-v2 = <0x06>;
			phandle = <0x0b>;
		};

		cpu@300 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x300>;
			enable-method = "psci";
			clocks = <0x04 0x03>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x39a>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x05>;
			operating-points-v2 = <0x06>;
			phandle = <0x0c>;
		};

		cpu@400 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x400>;
			enable-method = "psci";
			clocks = <0x04 0x04>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x162>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x07>;
			operating-points-v2 = <0x08>;
			phandle = <0x0d>;
		};

		cpu@500 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x500>;
			enable-method = "psci";
			clocks = <0x04 0x04>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x07>;
			operating-points-v2 = <0x08>;
			phandle = <0x0e>;
		};

		cpu@600 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x600>;
			enable-method = "psci";
			clocks = <0x04 0x04>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x07>;
			operating-points-v2 = <0x08>;
			phandle = <0x0f>;
		};

		cpu@700 {
			compatible = "arm,cortex-a55";
			device_type = "cpu";
			reg = <0x700>;
			enable-method = "psci";
			clocks = <0x04 0x04>;
			clock-latency-ns = <0x3b9b0>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			cpu-supply = <0x07>;
			operating-points-v2 = <0x08>;
			phandle = <0x10>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x09>;
				};

				core1 {
					cpu = <0x0a>;
				};

				core2 {
					cpu = <0x0b>;
				};

				core3 {
					cpu = <0x0c>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0d>;
				};

				core1 {
					cpu = <0x0e>;
				};

				core2 {
					cpu = <0x0f>;
				};

				core3 {
					cpu = <0x10>;
				};
			};
		};
	};

	osc24M-clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "osc24M";
		phandle = <0x2b>;
	};

	pmu {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x01 0x07 0x04>;
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		arm,no-tick-in-suspend;
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
	};

	thermal-zones {

		cpul-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x01>;

			trips {

				cpu-warn {
					temperature = <0x11170>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				cpu-hot {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x12>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x12>;
					cooling-device = <0x09 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		cpub-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x00>;

			trips {

				cpu-warn {
					temperature = <0x11170>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				cpu-hot {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x13>;
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x13>;
					cooling-device = <0x0d 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x02>;

			trips {

				gpu-warn {
					temperature = <0xea60>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				gpu-hot {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x14>;
				};

				gpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x00>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x14>;
					cooling-device = <0x15 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		npu-thermal {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x11 0x03>;
		};

		ddr-thermal {
			polling-delay-passive = <0x00>;
			polling-delay = <0x3e8>;
			thermal-sensors = <0x16 0x00>;
		};
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0x40000000>;

		gpu@1800000 {
			compatible = "allwinner,sun55i-a523-mali", "arm,mali-valhall-jm";
			reg = <0x1800000 0x10000>;
			interrupts = <0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x77 0x04>;
			interrupt-names = "job", "mmu", "gpu";
			clocks = <0x17 0x33 0x17 0x34>;
			clock-names = "core", "bus";
			power-domains = <0x18 0x01>;
			resets = <0x17 0x06>;
			dynamic-power-coefficient = <0x59a>;
			#cooling-cells = <0x02>;
			status = "okay";
			mali-supply = <0x19>;
			operating-points-v2 = <0x1a>;
			assigned-clocks = <0x17 0x15>;
			assigned-clock-rates = <0x297c1e00>;
			phandle = <0x15>;
		};

		video-engine@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
			reg = <0x1c0e000 0x1000 0x3000000 0x10>;
			interrupts = <0x00 0x78 0x04>;
			clocks = <0x17 0x39 0x17 0x38 0x17 0x4b>;
			clock-names = "bus_ve", "ve", "mbus_ve";
			resets = <0x17 0x09>;
			reset-names = "reset_ve";
			iommus = <0x03 0x02 0x03 0x03>;
			power-domains = <0x18 0x00>;
			nvmem-cells = <0x1b 0x1c>;
			nvmem-cell-names = "chipid", "ve-dvfs";
		};

		bus@5000000 {
			compatible = "allwinner,sun50i-h616-de33", "allwinner,sun50i-a64-de2";
			reg = <0x5000000 0x400000>;
			allwinner,sram = <0x1d 0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x5000000 0x400000>;

			clock@8000 {
				compatible = "allwinner,sun50i-h616-de33-clk";
				reg = <0x8000 0x100>;
				clocks = <0x17 0x2d 0x17 0x2e>;
				clock-names = "mod", "bus";
				resets = <0x17 0x02>;
				power-domains = <0x18 0x05>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				assigned-clocks = <0x17 0x2d>;
				assigned-clock-parents = <0x17 0x20>;
				assigned-clock-rates = <0x23c34600>;
				phandle = <0x1e>;
			};

			mixer@100000 {
				compatible = "allwinner,sun55i-a523-de33-mixer-0";
				reg = <0x100000 0x100000 0x8100 0x40 0x280000 0x20000 0x8000 0x60>;
				reg-names = "engine", "top", "display", "detop";
				clocks = <0x1e 0x00 0x1e 0x06>;
				clock-names = "bus", "mod";
				resets = <0x1e 0x00>;
				power-domains = <0x18 0x05>;
				iommus = <0x03 0x05>;
				memory-region = <0x1f>;
				phandle = <0x02>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x20>;
							phandle = <0x21>;
						};
					};
				};
			};
		};

		tcon-top@5500000 {
			compatible = "allwinner,sun50i-h6-tcon-top";
			reg = <0x5500000 0x1000>;
			clocks = <0x17 0x88 0x17 0x9a>;
			clock-names = "bus", "tcon-tv0";
			clock-output-names = "tcon-top-tv0";
			resets = <0x17 0x3b>;
			#clock-cells = <0x01>;
			power-domains = <0x18 0x03>;
			phandle = <0x25>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x00>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x21>;
						phandle = <0x20>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@2 {
						reg = <0x02>;
						remote-endpoint = <0x22>;
						phandle = <0x26>;
					};
				};

				port@4 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x04>;

					endpoint@0 {
						reg = <0x00>;
						remote-endpoint = <0x23>;
						phandle = <0x27>;
					};
				};

				port@5 {
					reg = <0x05>;

					endpoint {
						remote-endpoint = <0x24>;
						phandle = <0x29>;
					};
				};
			};
		};

		lcd-controller@5503000 {
			compatible = "allwinner,sun50i-h6-tcon-tv", "allwinner,sun8i-r40-tcon-tv";
			reg = <0x5503000 0x1000>;
			interrupts = <0x00 0x5b 0x04>;
			clocks = <0x17 0x9c 0x25 0x00>;
			clock-names = "ahb", "tcon-ch1";
			resets = <0x17 0x44>;
			reset-names = "lcd";
			power-domains = <0x18 0x03>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x26>;
						phandle = <0x22>;
					};
				};

				port@1 {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					reg = <0x01>;

					endpoint@1 {
						reg = <0x01>;
						remote-endpoint = <0x27>;
						phandle = <0x23>;
					};
				};
			};
		};

		hdmi@5520000 {
			compatible = "allwinner,sun55i-a523-dw-hdmi", "allwinner,sun50i-h6-dw-hdmi";
			reg = <0x5520000 0x10000>;
			reg-io-width = <0x01>;
			interrupts = <0x00 0x5d 0x04>;
			clocks = <0x17 0x8d 0x17 0x8a 0x17 0xb4 0x17 0x8c>;
			clock-names = "iahb", "isfr", "tmds", "cec";
			resets = <0x17 0x3d>;
			reset-names = "ctrl";
			power-domains = <0x18 0x03>;
			phys = <0x28>;
			phy-names = "phy";
			#sound-dai-cells = <0x00>;
			status = "okay";
			phandle = <0x5a>;

			ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x29>;
						phandle = <0x24>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x2a>;
						phandle = <0x58>;
					};
				};
			};
		};

		hdmi-phy@5530000 {
			compatible = "allwinner,sun55i-a523-hdmi-phy", "allwinner,sun50i-h616-hdmi-phy";
			reg = <0x5530000 0x10000>;
			clocks = <0x17 0x8d 0x17 0x8a>;
			clock-names = "bus", "mod";
			resets = <0x17 0x3e>;
			reset-names = "phy";
			power-domains = <0x18 0x03>;
			#phy-cells = <0x00>;
			phandle = <0x28>;
		};

		pinctrl@2000000 {
			compatible = "allwinner,sun55i-a523-pinctrl";
			reg = <0x2000000 0x800>;
			interrupts = <0x00 0x43 0x04 0x00 0x45 0x04 0x00 0x47 0x04 0x00 0x49 0x04 0x00 0x4b 0x04 0x00 0x4d 0x04 0x00 0x4f 0x04 0x00 0x51 0x04 0x00 0x53 0x04 0x00 0x55 0x04 0x00 0x8c 0x04>;
			clocks = <0x17 0x2b 0x2b 0x2c 0x00>;
			clock-names = "apb", "hosc", "losc";
			gpio-controller;
			#gpio-cells = <0x03>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			vcc-pb-supply = <0x2d>;
			vcc-pc-supply = <0x2e>;
			vcc-pd-supply = <0x2d>;
			vcc-pe-supply = <0x2f>;
			vcc-pf-supply = <0x2d>;
			vcc-pg-supply = <0x30>;
			vcc-ph-supply = <0x2d>;
			vcc-pi-supply = <0x2d>;
			vcc-pj-supply = <0x2e>;
			vcc-pk-supply = <0x2e>;
			phandle = <0x38>;

			mmc0-pins {
				pins = "PF0", "PF1", "PF2", "PF3", "PF4", "PF5";
				allwinner,pinmux = <0x02>;
				function = "mmc0";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x37>;
			};

			mmc1-pins {
				pins = "PG0", "PG1", "PG2", "PG3", "PG4", "PG5";
				allwinner,pinmux = <0x02>;
				function = "mmc1";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x39>;
			};

			mmc2-pins {
				pins = "PC0", "PC1", "PC5", "PC6", "PC8", "PC9", "PC10", "PC11", "PC13", "PC14", "PC15", "PC16";
				allwinner,pinmux = <0x03>;
				function = "mmc2";
				drive-strength = <0x1e>;
				bias-pull-up;
				phandle = <0x3c>;
			};

			rgmii0-pins {
				pins = "PH0", "PH1", "PH2", "PH3", "PH4", "PH5", "PH6", "PH7", "PH9", "PH10", "PH14", "PH15", "PH16", "PH17", "PH18";
				allwinner,pinmux = <0x05>;
				function = "gmac0";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x40>;
			};

			rgmii1-pins {
				pins = "PJ0", "PJ1", "PJ2", "PJ3", "PJ4", "PJ5", "PJ6", "PJ7", "PJ8", "PJ9", "PJ11", "PJ12", "PJ13", "PJ14", "PJ15";
				allwinner,pinmux = <0x05>;
				function = "gmac1";
				drive-strength = <0x28>;
				bias-disable;
				phandle = <0x42>;
			};

			uart0-pb-pins {
				pins = "PB9", "PB10";
				allwinner,pinmux = <0x02>;
				function = "uart0";
				phandle = <0x32>;
			};

			uart1-pins {
				pins = "PG6", "PG7";
				function = "uart1";
				allwinner,pinmux = <0x02>;
				phandle = <0x33>;
			};

			uart1-rts-cts-pins {
				pins = "PG8", "PG9";
				function = "uart1";
				allwinner,pinmux = <0x02>;
				phandle = <0x34>;
			};
		};

		clock-controller@2001000 {
			compatible = "allwinner,sun55i-a523-ccu";
			reg = <0x2001000 0x1000>;
			clocks = <0x2b 0x2c 0x00 0x2c 0x02 0x2c 0x01>;
			clock-names = "hosc", "losc", "iosc", "losc-fanout";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x17>;
		};

		ir@2005000 {
			compatible = "allwinner,sun55i-a523-ir", "allwinner,sun6i-a31-ir";
			reg = <0x2005000 0x400>;
			interrupts = <0x00 0x1b 0x04>;
			clocks = <0x17 0x77 0x17 0x76>;
			clock-names = "apb", "ir";
			resets = <0x17 0x2c>;
			status = "disabled";
		};

		thermal-sensor@2009400 {
			compatible = "allwinner,sun55i-a523-ths";
			reg = <0x2009400 0x400>;
			clocks = <0x17 0x7e 0x17 0x7b>;
			clock-names = "bus", "mod";
			resets = <0x17 0x30>;
			nvmem-cells = <0x31>;
			nvmem-cell-names = "calibration";
			#thermal-sensor-cells = <0x01>;
			phandle = <0x11>;
		};

		thermal-sensor@200a000 {
			compatible = "allwinner,sun55i-a523-ths-ddr";
			reg = <0x200a000 0x400>;
			clocks = <0x17 0x7e 0x17 0x7a>;
			clock-names = "bus", "mod";
			resets = <0x17 0x30>;
			nvmem-cells = <0x31>;
			nvmem-cell-names = "calibration";
			#thermal-sensor-cells = <0x01>;
			phandle = <0x16>;
		};

		iommu@2010000 {
			compatible = "allwinner,sun55i-a523-iommu", "allwinner,sun50i-h616-iommu";
			reg = <0x2010000 0x1000>;
			interrupts = <0x00 0x41 0x04>;
			clocks = <0x17 0x48>;
			resets = <0x17 0x4e>;
			#iommu-cells = <0x01>;
			phandle = <0x03>;
		};

		watchdog@2050000 {
			compatible = "allwinner,sun55i-a523-wdt";
			reg = <0x2050000 0x20>;
			interrupts = <0x00 0x3f 0x04>;
			clocks = <0x2b 0x2c 0x00>;
			clock-names = "hosc", "losc";
			status = "okay";
		};

