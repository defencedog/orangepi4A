+/*
+ * patched5: make a freshly uploaded local file visible in the folder tree
+ * immediately.
+ *
+ * mediafirefs_release() uploads a newly created file during close(), after
+ * which the kernel may issue rename() at once. Upstream relied on a later
+ * device/get_changes() refresh to surface the new file; that refresh can lag
+ * by seconds to minutes, so the kernel's rename lookup hit ENOENT and
+ * mediafirefs_rename() was never reached. Instead, reload just the parent
+ * directory's contents from MediaFire. folder/get_content is authoritative
+ * as soon as the upload has completed (poll status 99), so the new entry is
+ * present before release() returns.
+ */
+int folder_tree_reload_dir(folder_tree * tree, mfconn * conn, const char *path)
+{
+    struct h_entry *entry;
+
+    entry = folder_tree_lookup_path(tree, conn, path);
+    if (entry == NULL) {
+        fprintf(stderr, "reload_dir: %s does not exist\n", path);
+        return -ENOENT;
+    }
+    if (entry->atime != 0) {
+        fprintf(stderr, "reload_dir: %s is not a directory\n", path);
+        return -ENOTDIR;
+    }
+
+    return folder_tree_rebuild_helper(tree, conn, entry);
+}
+
+/*
+ * patched5: keep the local tree in sync after a successful remote rename in
+ * the same directory, without waiting for device/get_changes. Only the
+ * basename changed, so update the existing h_entry in place.
+ */
+int folder_tree_rename_entry(folder_tree * tree, mfconn * conn,
+                             const char *oldpath, const char *newpath)
+{
+    struct h_entry *entry;
+    char           *tmp;
+    char           *newname;
+
+    entry = folder_tree_lookup_path(tree, conn, oldpath);
+    if (entry == NULL) {
+        fprintf(stderr, "rename_entry: %s does not exist\n", oldpath);
+        return -ENOENT;
+    }
+
+    tmp = strdup(newpath);
+    if (tmp == NULL)
+        return -ENOMEM;
+    newname = basename(tmp);
+
+    strncpy(entry->name, newname, sizeof(entry->name) - 1);
+    entry->name[sizeof(entry->name) - 1] = '\0';
+
+    free(tmp);
+    return 0;
+}
+
 /*
  * clean up files and folders that are never referenced
  *
