#!/usr/bin/env bash
# ==============================================================================
# Orange Pi 4A (Allwinner T527) Hardware Monitor - Mobile Termux Edition
# Compact, ultra-clean telemetry dashboard (fits <38 cols portrait mobile)
# ==============================================================================

REFRESH_INTERVAL=1
RUN_ONCE=false

if [ "$1" = "--once" ] || [ "$1" = "-1" ]; then
    RUN_ONCE=true
elif [ -n "$1" ] && [ "$1" -eq "$1" ] 2>/dev/null; then
    REFRESH_INTERVAL="$1"
fi

# ANSI Styling
BOLD="\033[1m"
DIM="\033[2m"
RESET="\033[0m"
CYAN="\033[36m"
GREEN="\033[32m"
YELLOW="\033[33m"
RED="\033[31m"
BLUE="\033[34m"
MAGENTA="\033[35m"
WHITE="\033[37m"
GRAY="\033[90m"
BR_CYAN="\033[96m"

# Render colored progress bar (10 blocks = 12 chars [█████░░░░░])
draw_bar() {
    local val=$1
    local width=10
    local filled=$(( (val * width) / 100 ))
    [ "$filled" -gt "$width" ] && filled=$width
    [ "$filled" -lt 0 ] && filled=0
    local empty=$(( width - filled ))

    local color="$GREEN"
    if [ "$val" -ge 80 ]; then
        color="$RED"
    elif [ "$val" -ge 50 ]; then
        color="$YELLOW"
    fi

    local bar=""
    for ((i=0; i<filled; i++)); do bar="${bar}█"; done
    for ((i=0; i<empty; i++)); do bar="${bar}░"; done
    printf "${color}[%s]${RESET}" "$bar"
}

# Format milli-Celsius to compact Celsius string with color (e.g. 41.3°C)
format_temp() {
    local raw=$1
    if [ -z "$raw" ] || [ "$raw" -le 0 ]; then
        printf "${GRAY}--.-°C${RESET}"
        return
    fi
    local whole=$((raw / 1000))
    local frac=$(( (raw % 1000) / 100 ))

    local color="$GREEN"
    if [ "$whole" -ge 75 ]; then
        color="$RED"
    elif [ "$whole" -ge 60 ]; then
        color="$YELLOW"
    fi
    printf "${color}%2d.%d°C${RESET}" "$whole" "$frac"
}

# Compact Uptime (e.g. "1d 4h" or "3h 25m")
get_uptime() {
    local up_sec=0
    if [ -f /proc/uptime ]; then
        read -r up_sec _ < /proc/uptime
        up_sec=${up_sec%%.*}
        local d=$((up_sec / 86400))
        local h=$(( (up_sec % 86400) / 3600 ))
        local m=$(( (up_sec % 3600) / 60 ))
        if [ "$d" -gt 0 ]; then
            printf "%dd %dh" "$d" "$h"
        elif [ "$h" -gt 0 ]; then
            printf "%dh %dm" "$h" "$m"
        else
            printf "%dm" "$m"
        fi
    else
        printf "N/A"
    fi
}

# Dynamic thermal sensor discovery
SOC_TEMP_FILE="/sys/class/thermal/thermal_zone0/temp"
GPU_TEMP_FILE="/sys/class/thermal/thermal_zone2/temp"
NPU_TEMP_FILE="/sys/class/thermal/thermal_zone3/temp"
for z in /sys/class/thermal/thermal_zone*; do
    if [ -f "$z/type" ]; then
        ztype=$(cat "$z/type" 2>/dev/null)
        case "$ztype" in
            cpub-thermal) SOC_TEMP_FILE="$z/temp" ;;
            gpu-thermal)  GPU_TEMP_FILE="$z/temp" ;;
            npu-thermal)  NPU_TEMP_FILE="$z/temp" ;;
        esac
    fi
done

# Initial CPU stats
read -r _ u n s id io ir sir st _ < /proc/stat
prev_active=$((u + n + s + ir + sir + st))
prev_total=$((prev_active + id + io))

prev_npu_active=0
if [ -f /sys/devices/platform/soc/7122000.npu/power/runtime_active_time ]; then
    read -r prev_npu_active < /sys/devices/platform/soc/7122000.npu/power/runtime_active_time
fi
prev_vip_irqs=0
if grep -q 'vipcore' /proc/interrupts 2>/dev/null; then
    prev_vip_irqs=5
fi

# VPU (Allwinner cedar video engine) baseline: runtime PM + cedar_dev IRQs
VPU_POWER_DIR="/sys/devices/platform/soc/1c0e000.video-engine/power"
prev_vpu_active=0
if [ -f "$VPU_POWER_DIR/runtime_active_time" ]; then
    read -r prev_vpu_active < "$VPU_POWER_DIR/runtime_active_time"
fi
prev_vpu_irqs=0
if grep -q 'cedar_dev' /proc/interrupts 2>/dev/null; then
    prev_vpu_irqs=$(awk '/cedar_dev/{for(i=2;i<=NF;i++){if($i~/^[0-9]+$/){s+=$i}else break};print s+0}' /proc/interrupts)
fi

# G2D (Allwinner 2D graphics engine) baseline: 5440000.g2d IRQs
prev_g2d_irqs=0
if grep -qE '5440000\.g2d|g2d' /proc/interrupts 2>/dev/null; then
    prev_g2d_irqs=$(awk '/5440000\.g2d|g2d/{for(i=2;i<=NF;i++){if($i~/^[0-9]+$/){s+=$i}else break};print s+0}' /proc/interrupts)
fi

# Hide cursor during run, restore on exit
trap 'printf "\033[?25h\n"; exit 0' INT TERM EXIT
printf "\033[?25l\033[2J\033[H"

[ "$RUN_ONCE" = true ] && sleep 1
while true; do
    # 1. CPU Usage Calculation
    read -r _ u n s id io ir sir st _ < /proc/stat
    curr_active=$((u + n + s + ir + sir + st))
    curr_total=$((curr_active + id + io))

    diff_active=$((curr_active - prev_active))
    diff_total=$((curr_total - prev_total))

    if [ "$diff_total" -gt 0 ]; then
        cpu_usage=$(( (diff_active * 100) / diff_total ))
    else
        cpu_usage=0
    fi
    prev_active=$curr_active
    prev_total=$curr_total

    # Load average (1 min)
    read -r l1 _ < /proc/loadavg

    # 2. CPU Frequency & Temperature (Big cluster preferred for performance telemetry)
    raw_cpu_freq=0
    if [ -f /sys/devices/system/cpu/cpu4/cpufreq/scaling_cur_freq ]; then
        read -r raw_cpu_freq < /sys/devices/system/cpu/cpu4/cpufreq/scaling_cur_freq
    elif [ -f /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]; then
        read -r raw_cpu_freq < /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
    fi
    c_ghz=$((raw_cpu_freq / 1000000))
    c_frac=$(( (raw_cpu_freq % 1000000) / 10000 ))
    freq_cpu_str=$(printf "%d.%02dGHz" "$c_ghz" "$c_frac")

    raw_soc_temp=0
    [ -f "$SOC_TEMP_FILE" ] && read -r raw_soc_temp < "$SOC_TEMP_FILE"

    # 3. NPU (VeriSilicon GC9000 2 TOPS via etnaviv / renderD129)
    npu_load=0
    npu_online=false
    if [ -c /dev/dri/renderD129 ] || [ -d /sys/devices/platform/soc/7122000.npu/driver ]; then
        npu_online=true
        if [ -f /sys/devices/platform/soc/7122000.npu/power/runtime_active_time ]; then
            read -r curr_npu_active < /sys/devices/platform/soc/7122000.npu/power/runtime_active_time
            diff_npu=$((curr_npu_active - prev_npu_active))
            prev_npu_active=$curr_npu_active
            [ "$RUN_ONCE" = true ] && sleep_factor=1000
            if [ "$diff_npu" -gt 0 ]; then
                npu_load=$(( (diff_npu * 100) / 1000 ))
                [ "$npu_load" -gt 100 ] && npu_load=100
                [ "$npu_load" -eq 0 ] && npu_load=1
            fi
        fi
        if [ "$npu_load" -eq 0 ] && [ -f /sys/devices/platform/soc/7122000.npu/power/runtime_status ]; then
            read -r npu_stat < /sys/devices/platform/soc/7122000.npu/power/runtime_status
            if [ "$npu_stat" = "active" ]; then
                npu_load=100
            fi
        fi
    fi
    raw_npu_temp=0
    [ -f "$NPU_TEMP_FILE" ] && read -r raw_npu_temp < "$NPU_TEMP_FILE"

    # 4. GPU (Mali-G57 Panfrost via devfreq DVFS: 150MHz - 696MHz)
    freq_gpu=0
    raw_gpu_freq=0
    if [ -f /sys/class/devfreq/1800000.gpu/cur_freq ]; then
        read -r raw_gpu_freq < /sys/class/devfreq/1800000.gpu/cur_freq
        freq_gpu=$((raw_gpu_freq / 1000000))
    fi

    gpu_load=0
    if [ -f /sys/devices/platform/soc/1800000.gpu/devfreq/1800000.gpu/load ]; then
        read -r gpu_load_raw < /sys/devices/platform/soc/1800000.gpu/devfreq/1800000.gpu/load
        gpu_load=${gpu_load_raw%%@*}
        [ -z "$gpu_load" ] && gpu_load=0
    elif [ "$freq_gpu" -gt 150 ]; then
        gpu_load=$(( (freq_gpu - 150) * 100 / (696 - 150) ))
        [ "$gpu_load" -gt 100 ] && gpu_load=100
        [ "$gpu_load" -lt 0 ] && gpu_load=0
    else
        gpu_load=0
    fi

    raw_gpu_temp=0
    [ -f "$GPU_TEMP_FILE" ] && read -r raw_gpu_temp < "$GPU_TEMP_FILE"

    # 4b. VPU (Allwinner cedar video engine - omxh264dec / libcedarc)
    #     Load from Runtime-PM active time; cedar_dev IRQ rate is the decode
    #     throughput proxy (device has no devfreq/thermal zone of its own).
    vpu_online=false
    vpu_load=0
    vpu_irqs_rate=0
    if [ -d "$VPU_POWER_DIR" ] || [ -c /dev/cedar_dev ]; then
        vpu_online=true
        if [ -f "$VPU_POWER_DIR/runtime_active_time" ]; then
            read -r curr_vpu_active < "$VPU_POWER_DIR/runtime_active_time"
            diff_vpu=$((curr_vpu_active - prev_vpu_active))
            prev_vpu_active=$curr_vpu_active
            if [ "$diff_vpu" -gt 0 ]; then
                vpu_load=$(( (diff_vpu * 100) / 1000 ))
                [ "$vpu_load" -gt 100 ] && vpu_load=100
                [ "$vpu_load" -eq 0 ] && vpu_load=1
            fi
        fi
        curr_vpu_irqs=$(awk '/cedar_dev/{for(i=2;i<=NF;i++){if($i~/^[0-9]+$/){s+=$i}else break};print s+0}' /proc/interrupts)
        diff_vpu_irqs=$((curr_vpu_irqs - prev_vpu_irqs))
        prev_vpu_irqs=$curr_vpu_irqs
        if [ "$REFRESH_INTERVAL" -gt 0 ]; then
            vpu_irqs_rate=$(( diff_vpu_irqs / REFRESH_INTERVAL ))
        else
            vpu_irqs_rate=$diff_vpu_irqs
        fi
        [ "$vpu_irqs_rate" -lt 0 ] && vpu_irqs_rate=0
    fi

    # 4c. G2D (Allwinner 2D hardware graphics engine - sunxi_g2d)
    #     Tracks hardware rotation/blit completion via 5440000.g2d IRQs
    g2d_online=false
    g2d_load=0
    g2d_irqs_rate=0
    if [ -c /dev/g2d ] || [ -d /sys/devices/platform/soc/5440000.g2d/driver ]; then
        g2d_online=true
        curr_g2d_irqs=$(awk '/5440000\.g2d|g2d/{for(i=2;i<=NF;i++){if($i~/^[0-9]+$/){s+=$i}else break};print s+0}' /proc/interrupts)
        diff_g2d_irqs=$((curr_g2d_irqs - prev_g2d_irqs))
        prev_g2d_irqs=$curr_g2d_irqs
        if [ "$REFRESH_INTERVAL" -gt 0 ]; then
            g2d_irqs_rate=$(( diff_g2d_irqs / REFRESH_INTERVAL ))
        else
            g2d_irqs_rate=$diff_g2d_irqs
        fi
        [ "$g2d_irqs_rate" -lt 0 ] && g2d_irqs_rate=0
        if [ "$g2d_irqs_rate" -gt 0 ]; then
            # Map up to 120 ops/sec (peak 1080p hardware rotation capacity) to 100%
            g2d_load=$(( (g2d_irqs_rate * 100) / 120 ))
            [ "$g2d_load" -gt 100 ] && g2d_load=100
            [ "$g2d_load" -eq 0 ] && g2d_load=1
        fi
    fi

    # 5. Memory (RAM & Swap)
    mem_total_kb=0
    mem_avail_kb=0
    swap_total_kb=0
    swap_free_kb=0
    while read -r key val _; do
        case "$key" in
            MemTotal:) mem_total_kb="$val" ;;
            MemAvailable:) mem_avail_kb="$val" ;;
            SwapTotal:) swap_total_kb="$val" ;;
            SwapFree:) swap_free_kb="$val" ;;
        esac
    done < /proc/meminfo

    mem_total_mb=$((mem_total_kb / 1024))
    mem_avail_mb=$((mem_avail_kb / 1024))
    mem_used_mb=$((mem_total_mb - mem_avail_mb))
    mem_pct=0
    [ "$mem_total_mb" -gt 0 ] && mem_pct=$(( (mem_used_mb * 100) / mem_total_mb ))

    r_ugb=$((mem_used_mb / 1024))
    r_ufrac=$(( (mem_used_mb % 1024) * 10 / 1024 ))
    r_tgb=$((mem_total_mb / 1024))
    r_tfrac=$(( (mem_total_mb % 1024) * 10 / 1024 ))
    ram_str=$(printf "%d.%d/%d.%dG" "$r_ugb" "$r_ufrac" "$r_tgb" "$r_tfrac")

    swap_total_mb=$((swap_total_kb / 1024))
    swap_used_mb=$(( (swap_total_kb - swap_free_kb) / 1024 ))
    swap_pct=0
    [ "$swap_total_mb" -gt 0 ] && swap_pct=$(( (swap_used_mb * 100) / swap_total_mb ))

    s_ugb=$((swap_used_mb / 1024))
    s_ufrac=$(( (swap_used_mb % 1024) * 10 / 1024 ))
    s_tgb=$((swap_total_mb / 1024))
    s_tfrac=$(( (swap_total_mb % 1024) * 10 / 1024 ))
    swp_str=$(printf "%d.%d/%d.%dG" "$s_ugb" "$s_ufrac" "$s_tgb" "$s_tfrac")

    curr_time=$(date "+%H:%M:%S")
    uptime_fmt=$(get_uptime)

    # ----- Mobile-Optimized Render (Exact Width: 37 Columns) -----
    printf "\033[H"

    printf " ${BOLD}${WHITE}Orange Pi 4A${RESET} ${DIM}(T527)${RESET}\n"
    printf " ${GRAY}%s · Up: %-5s · Load: %s${RESET}\n" "$curr_time" "$uptime_fmt" "$l1"
    printf "${CYAN}─────────────────────────────────────${RESET}\n"

    # CPU Line: Name(4) %(5) Bar(12) Temp(7) Freq(8) = 36 cols
    printf " ${BOLD}${MAGENTA}CPU${RESET} %3d%% " "$cpu_usage"
    draw_bar "$cpu_usage"
    printf " %b  %-7s\n" "$(format_temp "$raw_soc_temp")" "$freq_cpu_str"

    # NPU Line: Name(4) %(5) Bar(12) Temp(7) Rating(8) = 36 cols
    if [ "$npu_online" = true ]; then
        printf " ${BOLD}${YELLOW}NPU${RESET} %3d%% " "$npu_load"
        draw_bar "$npu_load"
        printf " %b  ${DIM}2 TOPS${RESET}\n" "$(format_temp "$raw_npu_temp")"
    else
        printf " ${BOLD}${YELLOW}NPU${RESET} ${DIM}OFF ${RESET} "
        draw_bar 0
        printf " %b  ${DIM}OFFLINE${RESET}\n" "$(format_temp "$raw_npu_temp")"
    fi

    # GPU Line: Name(4) %(5) Bar(12) Temp(7) Freq(8) = 36 cols
    printf " ${BOLD}${GREEN}GPU${RESET} %3d%% " "$gpu_load"
    draw_bar "$gpu_load"
    printf " %b  %4dMHz\n" "$(format_temp "$raw_gpu_temp")" "$freq_gpu"

    # VPU Line: Name(4) %(5) Bar(12) IRQ/s(7) Engine(5) = 37 cols
    if [ "$vpu_online" = true ]; then
        printf " ${BOLD}${BR_CYAN}VPU${RESET} %3d%% " "$vpu_load"
        draw_bar "$vpu_load"
        printf " ${DIM}%5s/s${RESET}  ${DIM}cedar${RESET}\n" "$vpu_irqs_rate"
    else
        printf " ${BOLD}${BR_CYAN}VPU${RESET} ${DIM}OFF ${RESET} "
        draw_bar 0
        printf " ${DIM}OFFLINE${RESET}\n"
    fi

    # G2D Line: Name(4) %(5) Bar(12) IRQ/s(7) Engine(5) = 37 cols
    if [ "$g2d_online" = true ]; then
        printf " ${BOLD}${CYAN}G2D${RESET} %3d%% " "$g2d_load"
        draw_bar "$g2d_load"
        printf " ${DIM}%5s/s${RESET}  ${DIM}sunxi${RESET}\n" "$g2d_irqs_rate"
    else
        printf " ${BOLD}${CYAN}G2D${RESET} ${DIM}OFF ${RESET} "
        draw_bar 0
        printf " ${DIM}OFFLINE${RESET}\n"
    fi

    # RAM Line: Name(4) %(5) Bar(12) Used/Tot(9) Free(6) = 36 cols
    printf " ${BOLD}${BLUE}RAM${RESET} %3d%% " "$mem_pct"
    draw_bar "$mem_pct"
    printf " %-8s ${GRAY}%4dM free${RESET}\n" "$ram_str" "$mem_avail_mb"

    # SWP Line (ZRAM + NVMe swap)
    if [ "$swap_total_mb" -gt 0 ]; then
        printf " ${BOLD}${BLUE}SWP${RESET} %3d%% " "$swap_pct"
        draw_bar "$swap_pct"
        printf " %-8s\n" "$swp_str"
    fi

    printf "${CYAN}─────────────────────────────────────${RESET}\n"
    printf " ${GRAY}[Ctrl+C] Exit  ·  Refresh: %ds${RESET}\n" "$REFRESH_INTERVAL"
    printf "\033[J"

    if [ "$RUN_ONCE" = true ]; then
        break
    fi
    sleep "$REFRESH_INTERVAL"
done
