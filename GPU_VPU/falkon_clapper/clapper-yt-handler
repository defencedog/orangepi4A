#!/usr/bin/python3
"""clapper-yt-handler - convert clapper:// URLs into YouTube watch URLs.

This is the xdg-open handler for the `clapper` URL scheme.  Falkon (and any
other browser) hands us a URL such as:

    clapper://play?v=dQw4w9WgXcQ
    clapper://watch/dQw4w9WgXcQ

We validate the 11-character YouTube video id, build the canonical watch URL
used by Flow/FreeTube, and launch Clapper.  Only youtube.com watch URLs can be
produced, so a malicious page cannot use this handler to launch Clapper with
an arbitrary URL.

By default the handler invokes `clapper URI` with no `--new-window` flag.
Clapper's GApplication reuses the active window and selects the newly added
item, replacing the current playback.  This keeps exactly one Clapper window
(and one decode pipeline) on resource-constrained SBCs.  Pass `--new-window`
only for explicit debugging; `--enqueue` is not used because it adds to the
queue without switching playback.

On KDE Plasma, KWin's focus-stealing prevention blocks a background Clapper
window from raising itself after the handoff.  The handler therefore uses a
tiny KWin script to activate the reused window; this is best-effort and is
silently skipped on non-KDE sessions.

Install: ~/.local/bin/clapper-yt-handler (chmod 755)
Desktop: ~/.local/share/applications/clapper-yt-handler.desktop
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
import time
from urllib.parse import parse_qs, urlparse

LOG_PATH = os.path.expanduser("~/.cache/clapper-yt-handler.log")
RAISE_SCRIPT_PATH = os.path.expanduser("~/.cache/falkon-clapper/raise-clapper.js")
DEFAULT_PLAYER = "/usr/bin/clapper"
VIDEO_ID_RE = re.compile(r"^[A-Za-z0-9_-]{11}$")
QDBUS = shutil.which("qdbus6") or shutil.which("qdbus")

KWIN_SERVICE = "org.kde.KWin"
KWIN_PATH = "/Scripting"
KWIN_IFACE = "org.kde.kwin.Scripting"
KWIN_SCRIPT_IFACE = "org.kde.kwin.Script"

# KWin blocks gtk_window_present() from background clients, so ask the
# compositor to activate the existing Clapper window after the handoff.
RAISE_SCRIPT = """\
const wins = (typeof workspace.windowList === "function")
    ? workspace.windowList()
    : workspace.clientList();
for (const w of wins) {
    const resourceClass = String(w.resourceClass || "");
    const resourceName = String(w.resourceName || "");
    if (resourceClass === "com.github.rafostar.Clapper" ||
        resourceName === "clapper") {
        if (typeof workspace.windowList === "function")
            workspace.activeWindow = w;
        else
            workspace.activeClient = w;
        break;
    }
}
"""


def log(message: str) -> None:
    """Best-effort log; never let logging break the handoff."""
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        with open(LOG_PATH, "a", encoding="utf-8") as fh:
            fh.write(f"{time.strftime('%Y-%m-%d %H:%M:%S')} {message}\n")
    except OSError:
        pass


def parse_clapper_url(raw: str) -> str:
    """Return a validated 11-char video id from a clapper:// URL."""
    parsed = urlparse(raw)
    if parsed.scheme != "clapper":
        raise ValueError(f"unsupported scheme {parsed.scheme!r} (expected 'clapper')")

    video_id = None

    # clapper://play?v=ID  -> netloc=play, query v=ID
    query = parse_qs(parsed.query)
    if query.get("v"):
        video_id = query["v"][0]

    # clapper://watch/ID  -> netloc=watch, path=/ID
    # clapper:///watch/ID -> netloc='',    path=/watch/ID
    if not video_id:
        parts = [part for part in parsed.path.split("/") if part]
        if len(parts) >= 2 and parts[0] == "watch":
            video_id = parts[1]
        elif len(parts) == 1:
            video_id = parts[0]

    if not video_id:
        raise ValueError("missing video id")
    if not VIDEO_ID_RE.fullmatch(video_id):
        raise ValueError(f"invalid video id {video_id!r} (expected 11 chars [A-Za-z0-9_-])")
    return video_id


def ensure_raise_script() -> bool:
    """Write the fixed KWin activation script and return success."""
    try:
        os.makedirs(os.path.dirname(RAISE_SCRIPT_PATH), exist_ok=True)
        with open(RAISE_SCRIPT_PATH, "w", encoding="utf-8") as fh:
            fh.write(RAISE_SCRIPT)
        return True
    except OSError:
        return False


def raise_clapper_window() -> None:
    """Best-effort bring the reused Clapper window to the front on KDE.

    KWin focus-stealing prevention ignores a background window's
    gtk_window_present(), so the compositor itself must activate it.  Any
    failure (non-KDE session, KWin scripting disabled, timeout) is ignored:
    the video still plays in the existing window.
    """
    if not QDBUS or not ensure_raise_script():
        return

    plugin = f"falkon-clapper-raise-{os.getpid()}"
    base = [QDBUS, KWIN_SERVICE, KWIN_PATH]
    try:
        loaded = subprocess.run(
            [*base, f"{KWIN_IFACE}.loadScript", RAISE_SCRIPT_PATH, plugin],
            check=False,
            timeout=1.5,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        script_id = loaded.stdout.strip()
        if script_id.isdigit():
            # Run only this helper; Scripting.start() would re-run every
            # loaded KWin script, which is an unwanted global side effect.
            subprocess.run(
                [
                    QDBUS,
                    KWIN_SERVICE,
                    f"/Scripting/Script{script_id}",
                    f"{KWIN_SCRIPT_IFACE}.run",
                ],
                check=False,
                timeout=1.5,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            time.sleep(0.15)
        subprocess.run(
            [*base, f"{KWIN_IFACE}.unloadScript", plugin],
            check=False,
            timeout=1.5,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
    except (OSError, subprocess.TimeoutExpired):
        pass


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Open a clapper://play?v=ID URL in Clapper (cedar VPU)."
    )
    parser.add_argument("url", help="clapper:// URL passed by xdg-open")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the command instead of launching Clapper",
    )
    parser.add_argument(
        "--player",
        default=os.environ.get("CLAPPER_PLAYER", DEFAULT_PLAYER),
        help=f"player executable (default: {DEFAULT_PLAYER})",
    )
    parser.add_argument(
        "--new-window",
        action="store_true",
        help="open a new Clapper window instead of reusing the active one",
    )
    args = parser.parse_args()

    try:
        video_id = parse_clapper_url(args.url)
    except ValueError as exc:
        log(f"ERROR {exc} url={args.url!r}")
        print(f"clapper-yt-handler: {exc}", file=sys.stderr)
        return 2

    target = f"https://www.youtube.com/watch?v={video_id}"
    command = [args.player]
    if args.new_window:
        command.append("--new-window")
    command.append(target)

    if args.dry_run:
        print(" ".join(command))
        return 0

    log(f"launch id={video_id} player={args.player} target={target}")

    if args.new_window:
        # Debug escape hatch: preserve the old one-window-per-handoff behavior.
        try:
            os.execv(args.player, command)
        except OSError as exc:
            log(f"ERROR exec {args.player!r} failed: {exc}")
            print(
                f"clapper-yt-handler: failed to launch {args.player}: {exc}",
                file=sys.stderr,
            )
            return 1

    # Single-instance path: the client exits after handing the URI to the
    # primary instance (or becomes the primary itself), so do not wait for it.
    try:
        subprocess.Popen(
            command,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except OSError as exc:
        log(f"ERROR spawn {args.player!r} failed: {exc}")
        print(
            f"clapper-yt-handler: failed to launch {args.player}: {exc}",
            file=sys.stderr,
        )
        return 1

    # Give the primary instance time to select the new media, then raise the
    # reused window (KWin will not do that on Clapper's own request).
    time.sleep(0.4)
    raise_clapper_window()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
